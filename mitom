#!/usr/bin/env python3
"""mitom - MitoM, annotation workflow for animal mitochondrial genomes (one command for every step).

Usage: mitom <command> [options]        mitom <command> -h   shows the options of one command
       mitom --version

  setup              download the MITOS2 reference data refseq89m, write the config   = mito_env.py setup
  run                full workflow (input dedup, annotation - MitoM's core, or --engine mitoz / mitos2 -,
                     reorientation, rescue, rRNA HMM fallback, introns, boundary curation, NCBI submission
                     files, genome maps)                                               = mitom_pipeline.py run
  import             the same steps for existing MitoZ / MITOS2 results or any annotated GenBank, without
                     annotating again                                                  = mitom_pipeline.py import
  annotate | reorient | transfer_metadata | replace_organism | dedup
                     single parts of the workflow                                      = mitom_pipeline.py <cmd>
  doctor             which external programs are found; --write-config saves them      = mito_env.py doctor
  curate             boundary rules + NCBI names on GenBank files                     = mito_curate.py
  intron             introns (MFannot method)                                         = mito_intron.py
  trna               multi-method tRNA annotation                                     = mito_trna.py
  rescue             add genes the core missed from MITOS2                              = mito_rescue.py
  rrna-hmm           per-phylum 12S/16S HMMs: build / search                           = mito_rrna_hmm.py
  validate           NCBI table2asn validation and submission files                   = ncbi_validate.py
  fetch              download complete mitogenomes from NCBI by taxon / query          = mito_fetch.py
  check              audit existing GenBank annotation; lists records to re-annotate   = mito_check.py
  compare            original annotation vs MitoM, gene by gene                       = mito_compare.py
  nuc                nuclear markers in contigs: 18S-ITS1-5.8S-ITS2-28S rDNA, histones H1-H4
                     (fetch / build / annotate)                                        = mito_nuc.py

Typical:  mitom setup
          mitom run -i my_genomes.gb -o out          (clade and genetic code from the GenBank taxonomy)
          mitom run -i contigs.fasta -o out --clade Mollusca --genetic_code 5
          mitom import -i mitoz_or_mitos2_results/ -o out --clade Mollusca --genetic_code 5
"""
import os
import subprocess
import sys
from pathlib import Path

VERSION = "1.0.0"
HERE = Path(os.path.realpath(__file__)).parent
COMMANDS = {
    **{c: ("mitom_pipeline.py", [c]) for c in ("run", "import", "annotate", "reorient", "transfer_metadata",
                                               "replace_organism", "dedup")},
    "setup": ("mito_env.py", ["setup"]),
    "doctor": ("mito_env.py", ["doctor"]),
    "curate": ("mito_curate.py", []),
    "intron": ("mito_intron.py", []),
    "trna": ("mito_trna.py", []),
    "rescue": ("mito_rescue.py", []),
    "rrna-hmm": ("mito_rrna_hmm.py", []),
    "validate": ("ncbi_validate.py", []),
    "fetch": ("mito_fetch.py", []),
    "check": ("mito_check.py", []),
    "compare": ("mito_compare.py", []),
    "nuc": ("mito_nuc.py", []),
}


def _imports_biopython(py):
    """True when interpreter `py` (Python >= 3.8) can import Biopython."""
    try:
        return subprocess.run([py, "-c", "import sys, Bio; sys.exit(sys.version_info < (3, 8))"],
                              capture_output=True, timeout=120).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def python_with_biopython():
    """The interpreter that runs the scripts: the current one when it imports Biopython, else the python of the
    first conda environment mito_env knows that does (the first python3 on PATH may be a Miniforge base or an
    activated conda env without Biopython); None when there is none."""
    try:
        import Bio  # noqa: F401
        return sys.executable
    except ImportError:
        pass
    sys.path.insert(0, str(HERE))
    import mito_env
    for b in mito_env.env_bins():
        for name in ("python3", "python"):
            py = b / name
            if py.is_file() and os.access(py, os.X_OK) and _imports_biopython(str(py)):
                return str(py)
    return None


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if argv[0] in ("-V", "--version"):
        print(f"MitoM {VERSION}")
        return 0
    if argv[0] not in COMMANDS:
        print(f"mitom: unknown command '{argv[0]}' (mitom -h lists the commands)", file=sys.stderr)
        return 2
    script, pre = COMMANDS[argv[0]]
    py = python_with_biopython()
    if py is None:
        if argv[0] not in ("doctor", "setup"):        # doctor reports the missing Biopython itself
            print(f"Biopython not found for {sys.executable}; install MitoM with install.sh (one conda environment)",
                  file=sys.stderr)
            return 2
        py = sys.executable
    os.environ["MITOM_LAUNCHER"] = "1"                 # mitom_pipeline.py then calls itself `mitom <command>`
    os.execv(py, [py, str(HERE / script), *pre, *argv[1:]])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
